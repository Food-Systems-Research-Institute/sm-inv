@misc{ge2023OvercomingSupplyChain,
  type = {{{SSRN Scholarly Paper}}},
  title = {Overcoming {{Supply Chain Barriers}} to {{Expanding Beef Cattle Production}} in the {{Northeastern U}}.{{S}}},
  author = {Ge, Frank and Gomez, Miguel and Peters, Christian},
  year = 2023,
  month = oct,
  number = {4591473},
  eprint = {4591473},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4591473},
  urldate = {2025-09-29},
  abstract = {AbstractCONTEXTThere is growing interest in producing more beef from cattle raised in pasture-based systems, rather than grain-finishing feedlot systems in the U.S. Given the availability of high-quality forage, pastureland and markets in the Northeastern U.S., an expansion of beef production in the region contributes to a gradual shift toward grass-based finishing systems. ~However, the capacity of slaughter and processing facilities may be a barrier to expanded grass-finished beef production in the region.OBJECTIVESWe examine the capacity bottleneck problem in the region and identify the optimal capacity expansion plans to address any discovered bottleneck problems. We answer two questions: (1) Does the physical capacity of existing infrastructure in the Northeast meet the cattle slaughtering and processing demand in the beef production expansion scenarios? (2) If there are bottlenecks for slaughter or processing, to what extent should existing plant slaughter or processing capacity be expanded to meet the service demand while minimizing the total operating costs of the beef supply chain system?METHODSThrough modeling the optimal utilization of currently existing plant capacity in the region, this study identifies capacity expansion solutions to overcome the emerging bottleneck problems as grass-finished beef cattle production expands. The plant utilization problem is formulated as an optimization model with the objective of minimizing total costs associated with cattle assembly, slaughter, processing and distribution.RESULTS AND CONCLUSIONSOur results suggest that slaughter bottlenecks in New York State coincide with underutilized slaughter capacity in New England. Reducing plant numbers while increasing plant utilization rates or expanding the capacity of the remaining plants, would likely lead to greater cost savings. For those counties with lower cattle production, introducing mobile slaughter units (MSU) might be more cost-efficient for solving the capacity bottleneck problem than operating small-sized plants.SIGNIFICANCEThe study provides critical information to address current challenges to realize opportunities to expand the regional beef supply chain system in the Northeastern U.S. This study sheds light on ways to adjust and improve regional coordination mechanisms to enhance efficiency in grass-finished beef regional food systems under various production expansion scenarios.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {Agricultural Policy,Capacity bottleneck,grass-finished beef,Optimization}
}

