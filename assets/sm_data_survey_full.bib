@article{lipman2025EquitableFoodValue,
  title = {Equitable Food Value Chains through Collaborative Action [in an Inequitable Landscape]: {{Insights}} from {{Buffalo}}, {{New York}}},
  shorttitle = {Equitable Food Value Chains through Collaborative Action [in an Inequitable Landscape]},
  author = {Lipman, Micaela and Griffin, Domonique and Woyciesjes, Erik and Hall, Gabriella and Raja, Samina},
  year = 2025,
  month = jan,
  journal = {Journal of Agriculture, Food Systems, and Community Development},
