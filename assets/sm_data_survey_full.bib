@article{difiore2022AssociationsFoodInsecurity,
  title = {Associations {{Between Food Insecurity}} and {{Neighborhood Safety}}, {{Social Cohesion}}, {{Social Control}}, and {{Crime Among Mothers}} of {{Preschool-Aged Children}}},
